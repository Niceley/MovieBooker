# TMDB API Key - OBLIGATOIRE
# Obtenez votre clé API sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# JWT Secret (optionnel - une valeur par défaut est utilisée si non définie)
# Changez cette valeur en production pour la sécurité
# JWT_SECRET=your-super-secret-jwt-key-change-in-production

